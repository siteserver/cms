@page
@{ Layout = "_LayoutHome"; }
@section Styles{
  <link href="/sitefiles/assets/css/bootstrap-4.1.0.min.css" rel="stylesheet" type="text/css" />
  <link href="/sitefiles/assets/css/siteserver.min.css" rel="stylesheet" type="text/css" />
}

<div class="card" style="margin: 10px;">
  <div class="card-header" style="border-top: 3px solid #ef5350 !important;border-radius: 3px;">
    <strong>错误信息</strong>
  </div>
  <div class="card-body">
    <blockquote class="blockquote mb-0">
      <!-- 使用文本插值（自动 HTML 转义），禁止 v-html 渲染用户可控数据，防止 XSS -->
      <p v-if="message" style="word-wrap: break-word; white-space: pre-wrap; font-size: 14px; font-weight: bold;">{{ message }}</p>
      <p v-if="stackTrace" style="word-wrap: break-word; white-space: pre-wrap; font-size: 14px;">{{ stackTrace }}</p>
      <p v-if="createdDate" style="word-wrap: break-word; font-size: 14px;">{{ createdDate }}</p>
    </blockquote>
  </div>
</div>

@section Scripts{
  <script src="/sitefiles/assets/js/home/error.js" type="text/javascript"></script> }