@page
@{ Layout = "_Layout"; }

<div style="height: 10px"></div>
<el-form v-on:submit.native.prevent ref="form" :model="form" size="small" status-icon label-width="160px">
  <el-form-item label="操作">
    <el-radio v-model="form.isEncrypt" :label="true">加密</el-radio>
    <el-radio v-model="form.isEncrypt" :label="false">解密</el-radio>
  </el-form-item>
  <el-form-item :label="'需要' + (form.isEncrypt ? '加密' : '解密') + '的字符串'" prop="value" :rules="{ required: true, message: '请输入字符串' }">
    <el-input v-model="form.value" type="textarea" rows="5"></el-input>
  </el-form-item>
  <el-form-item v-if="results" :label="(form.isEncrypt ? '加密' : '解密') + '后的字符串'">
    <strong>{{ results }}</strong>
  </el-form-item>
</el-form>

<el-row>
  <el-col :span="24" align="center">
    <el-divider></el-divider>
    <div style="height: 10px"></div>
    <el-button size="small" type="primary" v-on:click="btnSubmitClick">确 定</el-button>
  </el-col>
</el-row>

<el-divider content-position="left">轮换 SecurityKey（仅超级管理员）</el-divider>
<el-alert type="warning" :closable="false" show-icon
  title="轮换后系统将自动重启，所有登录状态与 API AccessToken 失效（AccessToken 会重新生成），已生成页面中的动态、搜索、下载链接需在后台执行“生成全站页面”后才能使用。">
</el-alert>
<div style="height: 10px"></div>
<el-form v-on:submit.native.prevent ref="rotateForm" :model="rotateForm" size="small" label-width="160px">
  <el-form-item label="当前登录密码" prop="password" :rules="{ required: true, message: '请输入当前登录密码' }">
    <el-input v-model="rotateForm.password" type="password" autocomplete="current-password" show-password></el-input>
  </el-form-item>
  <el-form-item>
    <el-button size="small" type="danger" v-on:click="btnRotateKeyClick">轮换 SecurityKey</el-button>
  </el-form-item>
</el-form>

@section Scripts{
<script src="/sitefiles/assets/js/admin/settings/utilitiesEncrypt.js" type="text/javascript"></script> }